# AgriGPT Backend Environment Variables

# ===========================
# REQUIRED - API Keys
# ===========================
GOOGLE_API_KEY=your_google_api_key
PINECONE_API_KEY=your_pinecone_api_key

# ===========================
# REQUIRED - Supabase Auth
# ===========================
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
SUPABASE_URL=https://your-project.supabase.co

# ===========================
# REQUIRED - Admin Access
# ===========================
ADMIN_EMAILS=admin@email.com

# ===========================
# OPTIONAL - Pinecone Indexes (defaults shown)
# ===========================
# CROP_INDEX_NAME=agrigpt-crops
# SCHEMES_INDEX_NAME=agrigpt-schemes

# ===========================
# OPTIONAL - AI Models (defaults shown)
# ===========================
# CLIP_MODEL=openai/clip-vit-base-patch32
# CLIP_EMBEDDING_DIM=512
# LLM_MODEL=gemini-2.5-flash
# LLM_TEMPERATURE=0.3
# VISION_MODEL=gemini-2.0-flash

# ===========================
# OPTIONAL - Text Chunking (defaults shown)
# ===========================
# CHUNK_SIZE=500
# CHUNK_OVERLAP=100

# ===========================
# OPTIONAL - Rate Limits (defaults shown)
# ===========================
# RATE_LIMIT_UPLOAD=5/minute
# RATE_LIMIT_QUERY=20/minute
# RATE_LIMIT_DEFAULT=60/minute

# ===========================
# OPTIONAL - Environment
# ===========================
# ENVIRONMENT=development